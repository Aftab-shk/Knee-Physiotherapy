# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
physio-env/
venv/
pe/
# Generated knowledge-graph output, rebuildable from the sources.
graphify-out/
env/
*.egg-info/

# ── Model weights (large — never commit binaries to git) ────────────────
# NOTE: these were once written as `model/*.pth`. A pattern containing a slash
# is anchored to this file's directory, so it only ever matched <repo>/model/
# and never backend/model/ — which is why a 70 MB checkpoint sat tracked in the
# repo for four commits. Keep the `**/` prefix, or drop the directory entirely.
*.pt
*.pth
*.pth.*
*.onnx
*.safetensors
**/model/training_curves.png
**/model/confusion_matrix*.png
**/model/*_report.json
**/model/history.json
**/model/label_map.json
**/model/predictions.json

# ── Datasets (large — never commit to git) ───────────────────────────────
data/
combined/
archive/
*.zip

# ── Local database ───────────────────────────────────────────────────────
# SQLite lives beside backend/ by default (see backend/db.py). It holds real
# patient rows and password hashes — never commit it. -wal and -shm are the
# write-ahead-log sidecars SQLite creates in WAL mode.
*.db
*.db-wal
*.db-shm

# ── Environment / secrets ────────────────────────────────────────────────
.env
.env.local

# ── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ── Docker ────────────────────────────────────────────────────────────────
*.log
# Playwright CLI output (may contain credentials)
.playwright-cli/
# Local browser-driver config (fake camera device for testing tracker.html).
.playwright/

# ── Agent skills ─────────────────────────────────────────────────────────
# Vendored third-party skill packs (ui-ux-pro-max, apple-design and friends):
# ~257 files of someone else's reference material, re-installable on demand and
# not this project's source. Only skills/ is ignored — if project-level Claude
# settings or commands are added later they belong in the repo, shared.
.claude/skills/

# The skills CLI (`npx skills add ...`) unpacks the real files here and
# symlinks .claude/skills/ at them. Same call as above: vendored content, not
# our source. skills-lock.json is deliberately NOT ignored - it pins each
# skill's origin and content hash, so `npx skills install` reproduces this set
# from a clean clone. Lockfile tracked, payload ignored, as with any other
# dependency.
.agents/skills/
